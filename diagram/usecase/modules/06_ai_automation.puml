@startuml
!theme plain
title Use Case - AI và xử lý tự động

left to right direction
skinparam shadowing false
skinparam roundcorner 10
skinparam linetype ortho
skinparam ArrowMessageAlignment center
skinparam packageStyle rectangle
skinparam nodesep 34
skinparam ranksep 38

actor "Bạn đọc" as Reader
actor "Thủ thư" as Librarian
actor "Gemini API" as Gemini
actor "Dịch vụ Email" as EmailService

rectangle "Hệ thống LMS - AI và xử lý tự động" {
  usecase "Tìm kiếm\nngữ nghĩa" as UC_SemanticSearch
  usecase "Xem gợi ý\ncá nhân hóa" as UC_Recommendations
  usecase "Xem sách\ntương tự" as UC_SimilarBooks
  usecase "Xử lý PDF\nbằng AI" as UC_ProcessPdfAI
  usecase "Trích xuất\nvăn bản PDF" as UC_ExtractPdf
  usecase "Tạo embedding\ncho tài liệu" as UC_CreateEmbedding
  usecase "Sinh tóm tắt,\ntag và đối tượng đọc" as UC_GenerateMetadata
  usecase "Ghi nhận tương tác\nngười dùng" as UC_RecordInteraction
  usecase "Sinh gợi ý\nsách" as UC_GenerateRecommendation
  usecase "Đẩy thông báo\nrealtime/email" as UC_SendNotification
}

Reader --> UC_SemanticSearch
Reader --> UC_Recommendations
Reader --> UC_SimilarBooks
Reader --> UC_RecordInteraction

Librarian --> UC_ProcessPdfAI
Librarian --> UC_SendNotification

Gemini --> UC_GenerateMetadata
EmailService --> UC_SendNotification

UC_ProcessPdfAI ..> UC_ExtractPdf : <back:#FFFFFF><<include>></back>
UC_ProcessPdfAI ..> UC_CreateEmbedding : <back:#FFFFFF><<include>></back>
UC_ProcessPdfAI ..> UC_GenerateMetadata : <back:#FFFFFF><<include>></back>
UC_SemanticSearch ..> UC_CreateEmbedding : <back:#FFFFFF><<include>></back>
UC_Recommendations ..> UC_GenerateRecommendation : <back:#FFFFFF><<include>></back>
UC_GenerateRecommendation ..> UC_RecordInteraction : <back:#FFFFFF><<include>></back>
UC_SimilarBooks ..> UC_CreateEmbedding : <back:#FFFFFF><<include>></back>

UC_SemanticSearch -[hidden]right- UC_Recommendations
UC_Recommendations -[hidden]right- UC_ProcessPdfAI
UC_ProcessPdfAI -[hidden]right- UC_SendNotification

@enduml
